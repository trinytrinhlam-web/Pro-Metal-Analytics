# Supabase — lấy ở Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # KHÓA BÍ MẬT, chỉ dùng ở server, không bao giờ để lộ

# Chuỗi ngẫu nhiên để ký cookie đăng nhập. Tạo bằng: openssl rand -base64 32
SESSION_SECRET=

# Gemini — dùng cho phần nhập bằng giọng nói. Để trống thì nút ghi âm tự ẩn đi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_VERSION=v1beta
