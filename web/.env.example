# Supabase — cách nhanh nhất: bấm nút Connect màu xanh ở thanh trên cùng của dashboard,
# hộp hiện ra có sẵn cả URL lẫn khoá theo đúng định dạng .env
# Chỉ lấy tới .supabase.co — trang Data API hiện thêm đuôi /rest/v1/, bỏ đuôi đó đi.
# (Có dán nhầm cả đuôi thì app cũng tự cắt, nhưng cứ để đúng cho sạch.)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# KHOÁ BÍ MẬT, chỉ dùng ở server, không bao giờ để lộ.
# Settings → API Keys → mục "Secret keys" → dòng default → bấm con mắt để hiện.
# Khoá mới bắt đầu bằng sb_secret_ ; khoá cũ service_role (eyJ...) vẫn dùng được.
# KHÔNG dùng Publishable key (sb_publishable_) — đó là khoá công khai.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Chuỗi ngẫu nhiên để ký cookie đăng nhập. Tạo bằng: openssl rand -base64 32
SESSION_SECRET=

# Gemini — dùng cho phần nhập bằng giọng nói. Để trống thì nút ghi âm tự ẩn đi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_VERSION=v1beta
